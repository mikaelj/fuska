{
  "name": "fuska-magistern",
  "version": "0.4.0",
  "description": "Fuska - Lean solo agentic development with MegaMemory knowledge graph",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fuska": "./dist/cli.js"
  },
  "scripts": {
    "prepublishOnly": "npm whoami",
    "build": "tsc && npm run build:claude",
    "build:claude": "ts-node scripts/build-claude.ts",
    "prepare": "npm run validate:help && npm run build",
    "validate:help": "ts-node scripts/validate-help-sync.ts",
    "test": "jest",
    "watch": "tsc --watch"
  },
  "keywords": [
    "fuska",
    "megamemory",
    "agentic"
  ],
  "author": "Mikael Jansson",
  "homepage": "http://github.com/mikaelj/fuska",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelj/fuska.git"
  },
  "bugs": {
    "url": "https://github.com/mikaelj/fuska/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "provider/opinkode/",
    "provider/klod/"
  ],
  "dependencies": {
    "commander": "^12.0.0",
    "fast-fuzzy": "^1.12.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "gray-matter": "^4.0.3",
    "inquirer": "^9.2.0",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "jsonc-parser": "^3.3.1",
    "megamemory": "^1.5.0",
    "string-width": "^8.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/inquirer": "^9.0.0",
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
